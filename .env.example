# Lines left commented fall back to the default in src/eroll/settings.py.

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Postgres and Redis on the local stack (the pod reaches them through the SSH tunnel)
# deploy/docker-compose.yml only: container passwords. Keep them equal to the passwords
# inside DATABASE_URL and REDIS_URL below.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://eroll:change-me@127.0.0.1:5432/eroll
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# API key for every endpoint. The API refuses to start below 32 characters, so this
# placeholder must be replaced
API_KEY=change-me

# deploy/docker-compose.yml only: Grafana admin password, applied when the grafana-data
# volume is first created. Grafana is published on 127.0.0.1:3000 only.
GRAFANA_ADMIN_PASSWORD=change-me

# vLLM server on pod loopback
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 1 to 256
MAX_CONCURRENT_REQUESTS=32
# Seconds, greater than 0
REQUEST_TIMEOUT_SECONDS=120

# Mean token log probability, at most 0. Leave unset to flag no Record on confidence.
# CONFIDENCE_THRESHOLD=-0.5

# Bytes, greater than 0 (200 MiB)
MAX_UPLOAD_BYTES=209715200

# GPU price in USD per hour, greater than 0
HOURLY_USD=0.74

# RunPod pod self-termination (GPU worker only). RunPod sets RUNPOD_POD_ID inside every
# pod; it is only needed here when running the worker outside a pod.
RUNPOD_POD_ID=change-me
RUNPOD_API_KEY=change-me

# deploy/launch_pod.ps1 only (read from the shell environment, not by settings.py):
# image owner for ghcr.io/<owner>/eroll-gpu and the SSH public key put on the pod
GHCR_OWNER=change-me
PUBLIC_KEY=ssh-ed25519 change-me
